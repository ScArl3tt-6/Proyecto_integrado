# Copiar como .env y completar. El archivo .env nunca se sube al repositorio.
NODE_ENV=development
SST_PUERTO=3000
# Secreto de firma de tokens: mínimo 32 caracteres aleatorios (en producción, desde el gestor de secretos)
SST_JWT_SECRETO=

# MongoDB real con autenticación (ver docs/VER_LAS_BASES_DE_DATOS.md). Los tres usuarios los crea
# scripts/db/mongo-crear-usuarios.js (npm run mongo:iniciar) la primera vez; aquí solo hay valores
# ficticios de referencia.
# sst_app: readWrite SOLO sobre sst_kotoduo (la aplicación en marcha).
SST_MONGO_URI=mongodb://sst_app:CLAVE_DE_EJEMPLO@127.0.0.1:27027/sst_kotoduo?authSource=sst_kotoduo
SST_MONGO_BASE=sst_kotoduo
# sst_pruebas: readWrite + dbAdmin sobre cualquier base, para crear y borrar una base temporal por
# cada ejecución de la suite automática (sst_prueba_xxxx).
SST_MONGO_PRUEBAS_URI=mongodb://sst_pruebas:CLAVE_DE_EJEMPLO@127.0.0.1:27027/admin?authSource=admin

# PostgreSQL 16 real. Las tres URL las genera scripts/db/crear-base-postgres.js (npm run db:crear) la
# primera vez que se ejecuta; aquí solo se muestran valores ficticios para referencia.
# sst_app: SELECT/INSERT/UPDATE mínimos por tabla, sin permisos de esquema (la aplicación en marcha).
SST_PG_URL=postgresql://sst_app:CLAVE_DE_EJEMPLO@127.0.0.1:5432/sst_kotoduo
# sst_propietario: dueña del esquema, solo para scripts de migración (nunca la usa la aplicación).
SST_PG_PROPIETARIO_URL=postgresql://sst_propietario:CLAVE_DE_EJEMPLO@127.0.0.1:5432/sst_kotoduo
# sst_pruebas: rol con CREATEDB (sin superusuario) que usa la suite automática para crear y borrar
# una base temporal por cada ejecución.
SST_PG_PRUEBAS_URL=postgresql://sst_pruebas:CLAVE_DE_EJEMPLO@127.0.0.1:5432/postgres
